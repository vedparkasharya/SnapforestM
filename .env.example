# ============================================================
# Snapforest Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or real credentials.
# ============================================================

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/snapforest

# Authentication (REQUIRED)
# Use a random secret with at least 32 characters.
AUTH_SECRET=replace_with_a_random_32_character_or_longer_secret

# Razorpay (required for real payments)
RAZORPAY_KEY_ID=rzp_live_your_live_key_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Cloudinary (optional, for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional, for booking confirmations)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# App URL
NEXT_PUBLIC_APP_URL=https://snapforest.in
NEXTAUTH_URL=https://snapforest.in

# Development only
ALLOW_DEMO_PAYMENTS=true
SEED_SECRET=replace_with_a_strong_dev_only_seed_secret
